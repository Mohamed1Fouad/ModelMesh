{
  "name": "modelmesh",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source AI routing platform. Route every request to the right model automatically using your own API keys.",
  "author": "ModelMesh Contributors",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @modelmesh/db migrate",
    "db:generate": "pnpm --filter @modelmesh/db generate",
    "db:studio": "pnpm --filter @modelmesh/db studio",
    "gateway:dev": "pnpm --filter @modelmesh/gateway dev",
    "dashboard:dev": "pnpm --filter @modelmesh/dashboard dev",
    "sdk:build": "pnpm --filter @modelmesh/sdk build"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "@modelmesh/config": "workspace:*"
  },
  "packageManager": "pnpm@9.14.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}